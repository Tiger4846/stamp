// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// External users table (managed by another system)
// This model is only for reading data, not for Prisma to manage the table structure
model ExternalUser {
  id                         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  organization               String?   @db.VarChar(255)
  fullname                   String?   @db.VarChar(255)
  name_eng                   String?   @db.VarChar(255)
  nickname                   String?   @db.VarChar(255)
  job_title                  String?   @db.VarChar(255)
  phone_number               String?   @db.VarChar(255)
  email                      String?   @db.VarChar(255)
  status                     String?   @db.VarChar(255)
  status_card                String?   @db.VarChar(255)
  industry                   String?   @db.VarChar(255)
  team                       String?   @db.VarChar(255)
  employee_id                String?   @db.VarChar(255)
  year                       String?   @db.VarChar(255)
  number                     String?   @default("0") @db.VarChar(255)
  number_child               String?   @default("0") @db.VarChar(255)
  number_child_over_six_year String?   @default("0") @db.VarChar(255)
  number_adult               String?   @default("0") @db.VarChar(255)
  remark                     String?   @db.Text
  signaturepath              String?   @db.Text
  created_at                 DateTime?
  updated_at                 DateTime?

  @@map("users")
  @@ignore
}

model User {
  id          String         @id @default(uuid())
  name        String
  role        UserRole      @default(user)
  phone       String @unique
  qrCode      String @unique
  isClaimed   Boolean      @default(false)

  managedSponsors Sponsor[]  @relation("SponsorAdmin")
  stampTotals     UserStamp[]
  transactions    StampTransaction[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("User")
}

enum UserRole {
  user
  admin
}

model Sponsor {
  id          String       @id @default(uuid())
  name        String
  phone       String?
  level       SponsorLevel
  adminId     String
  logoUrl     String?

  admin         User       @relation("SponsorAdmin", fields: [adminId], references: [id])
  transactions StampTransaction[]
  userStamps    UserStamp[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum SponsorLevel {
  gold
  silver
}

model UserStamp {
  id        String   @id @default(uuid())
  userId    String
  sponsorId String
  total     Int      @default(0)

  user      User     @relation(fields: [userId], references: [id])
  sponsor   Sponsor  @relation(fields: [sponsorId], references: [id])

  @@unique([userId, sponsorId])
}

model StampTransaction {
  id          String   @id @default(uuid())
  userId      String
  sponsorId   String
  amount      Int      @default(1)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  sponsor     Sponsor  @relation(fields: [sponsorId], references: [id])
}
